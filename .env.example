# ============================================================
# いちばん速い道：AI Studio の APIキー1本
#   GCPプロジェクトも、課金の紐付けも、ADCログインも要りません。
#   キーは https://aistudio.google.com/apikey で取れます。
#   会話画面(/kid)を動かすだけならこれで足ります。
# ============================================================
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=ここにAI_StudioのAPIキー

# デモモード。カレンダーに繋がず、ダミーのやることで動く。
# 「終わった」もその場では反映されます（プロセスを再起動すると戻ります）。
MIMAMORI_DEMO=1

# 子どもの設定（カンマ区切り。name:school_level）
# school_level は elementary / junior_high
# ここに入れた名前がカレンダーの件名と会話に出ます。呼び名でもOK。
MIMAMORI_CHILDREN=上の子:junior_high,下の子:elementary

MIMAMORI_MODEL=gemini-2.5-flash


# ============================================================
# 本番の道：Vertex AI + 実際のGoogleカレンダー
#   上の3行（USE_VERTEXAI / API_KEY / DEMO）を消して、こちらを使う。
# ============================================================
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# 反映先カレンダーID。自分のGoogleカレンダーなら普段のメールアドレス。
# Cloud Run で動かすときは、このカレンダーの
#   設定 → 特定のユーザーやグループとの共有
# に、サービスアカウントのアドレスを「予定の変更権限」で追加すること。
# MIMAMORI_CALENDAR_ID=you@example.com

# 予定の何分前に通知するか（分。カンマ区切り）
# MIMAMORI_REMINDERS=1200,60


# --- 注意 ---
# このアプリは外部から来た画像（おたより）を LLM に読ませる。
# 本番用の GCP プロジェクトは、本戦提出物（okane-kenko）とは別にすること。
